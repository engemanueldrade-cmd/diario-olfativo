# Chave da API Fragella (https://api.fragella.com) — pegue a sua no painel deles.
# Fica só no servidor: nunca é enviada ao navegador.
FRAGELLA_API_KEY=

# Preenchidas automaticamente pela Vercel quando você conecta um banco Redis
# (Storage → Marketplace → Upstash Redis) ao projeto. Não precisa editar
# manualmente em produção — só se for rodar localmente (vercel env pull .env.local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
