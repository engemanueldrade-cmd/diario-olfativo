# Chave da API Fragella (https://api.fragella.com) — pegue a sua no painel deles.
# Fica só no servidor: nunca é enviada ao navegador.
FRAGELLA_API_KEY=

# Projeto Supabase (https://supabase.com) — Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY tem acesso total ao banco: NUNCA leve o prefixo
# NEXT_PUBLIC_ nela, e nunca a exponha no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
